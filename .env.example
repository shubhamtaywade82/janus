# ── Backend ─────────────────────────────────────────────────────
APP_ID=                   # Application ID
APP_SECRET=               # Application secret (used for JWT signing)

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=             # MySQL connection string (mysql://user:pass@host:port/db)

# ── Frontend (exposed to browser via Vite) ──────────────────────
VITE_AUTH_URL=            # OAuth server URL (e.g. https://auth.example.com)
VITE_APP_ID=              # OAuth application ID

# ── Backend (Auth) ─────────────────────────────────────────────
AUTH_URL=                 # OAuth server URL (backend)
AUTH_PLATFORM_URL=        # OAuth Open Platform URL (e.g. https://open.example.com)

# ── Admin Role ──────────────────────────────────────────────────
OWNER_UNION_ID=           # Union ID of the app creator; this user gets role "admin" on first login

# ── Live Order Execution ────────────────────────────────────────
PLACE_ORDERS=             # Set to "true" to enable real CoinDCX order placement (default: false = paper mode)

# ── Bot Automation ──────────────────────────────────────────────
BOT_AUTO_START=           # Set to "true" to start auto-executor on server boot (default: false)

# ── Ollama / LLM Advisor (multi-key rotation) ───────────────────
OLLAMA_BASE_URL=          # API base URL — local: http://localhost:11434  cloud: https://api.your-provider.com
OLLAMA_MODEL=             # Model name, e.g. llama3.2, mistral, deepseek-r1 (default: llama3.2)
OLLAMA_TIMEOUT_MS=        # Per-request LLM timeout in ms (default: 15000)

# Key pool — provide one or more, bot rotates on 429 rate-limit:
OLLAMA_API_KEYS=          # Comma-separated: key1,key2,key3   (preferred batch format)
OLLAMA_API_KEY_1=         # Individual key slot 1 (alternative to OLLAMA_API_KEYS)
OLLAMA_API_KEY_2=         # Individual key slot 2
OLLAMA_API_KEY_3=         # Individual key slot 3
# Add more OLLAMA_API_KEY_N as needed (up to 20 supported)
