# ═══════════════════════════════════════════════════════════════════════
# Janus Trading Bot — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
#
# Production requirements:
#   APP_SECRET, DATABASE_URL, AUTH_URL, AUTH_PLATFORM_URL, ENCRYPTION_KEY
#
# Generate a new ENCRYPTION_KEY:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═══════════════════════════════════════════════════════════════════════

# ── Server ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010

# ── Core OAuth / Auth ───────────────────────────────────────────────────
APP_ID=your_oauth_app_id
APP_SECRET=your_jwt_signing_secret_min_32_chars
AUTH_URL=https://your-auth-provider.example.com
AUTH_PLATFORM_URL=https://your-auth-provider.example.com/platform

# Browser-visible OAuth URLs (used by Vite at build time)
VITE_AUTH_URL=https://your-auth-provider.example.com
VITE_APP_ID=your_oauth_app_id

# First user to log in with this union_id gets role=admin
OWNER_UNION_ID=your_owner_union_id

# ── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgres://janus:change_me@localhost:5432/janus_production

# PostgreSQL container vars (used by docker-compose.yml)
POSTGRES_DB=janus_production
POSTGRES_USER=janus
POSTGRES_PASSWORD=change_me_strong_password

# ── Security ────────────────────────────────────────────────────────────
# AES-256-GCM key for encrypting API credentials at rest
# REQUIRED in production — generate with the command at the top of this file
ENCRYPTION_KEY=

# ── Trading Safety ──────────────────────────────────────────────────────
# Both must be explicitly set to "true" to enable live trading
# Default is OFF to prevent accidental order placement
PLACE_ORDERS=false
AUTO_EXECUTE=false

# ── Paper Trading ───────────────────────────────────────────────────────
# Set to "true" to enable paper trading mode
# All signals fire, positions are DB-only with isPaper=true, no exchange orders
# Telegram shows "PAPER:" prefix on all alerts
PAPER_TRADING=false

# ── Testnet ─────────────────────────────────────────────────────────────
# Set to "true" to route Binance market data to testnet endpoints
# CoinDCX does not offer a public testnet; use PAPER_TRADING for execution testing
USE_TESTNET=false

# ── Bot Automation ──────────────────────────────────────────────────────
# Auto-start the executor on server boot (requires AUTO_EXECUTE=true)
# Kill switch auto-reset TTL in ms (default 3600000 = 1 hour; set 0 to disable)
# KILL_SWITCH_AUTO_RESET_MS=3600000
BOT_AUTO_START=false

# ── Telegram Notifications ──────────────────────────────────────────────
# Create a bot via @BotFather, start a chat to get chat ID
# Leave blank to disable Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Override Bot API host if api.telegram.org is blocked (local Bot API server / proxy)
TELEGRAM_API_BASE=https://api.telegram.org
# TELEGRAM_CONNECT_TIMEOUT_MS=5000

# ── LLM / AI — Entry Signal Advisor ────────────────────────────────────
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=90000

# Cloud Ollama key pool (comma-separated)
OLLAMA_API_KEYS=
OLLAMA_API_KEY_1=
OLLAMA_API_KEY_2=
OLLAMA_API_KEY_3=

# ── LLM / AI — Position Manager (live positions) ───────────────────────
# Used when no pm-live-* keys exist in the llm_api_keys DB table
PM_OLLAMA_CLOUD_ENDPOINT=https://ollama.com
PM_OLLAMA_CLOUD_MODEL=gpt-oss:120b
PM_OLLAMA_CLOUD_KEY_1=
PM_OLLAMA_CLOUD_KEY_2=
PM_OLLAMA_CLOUD_KEY_3=

# ── Observability ───────────────────────────────────────────────────────
# debug | info | warn | error  (default: info)
LOG_LEVEL=info
