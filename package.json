{
  "name": "my-app",
  "private": true,
  "version": "0.0.0",
  "workspaces": ["packages/*"],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dedup-paper": "node --loader ts-node/esm src/scripts/dedup-paper-positions.js",
    "build": "vite build && esbuild api/boot.ts --platform=node --bundle --packages=external --format=esm --outdir=dist --banner:js=\"import { createRequire } from 'module';const require = createRequire(import.meta.url);\"",
    "lint": "eslint .",
    "preview": "vite preview",
    "start": "NODE_ENV=production node dist/boot.js",
    "check": "tsc -b",
    "format": "prettier --write .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "docker compose exec -T postgres psql -U janus -d janus_production -c \"DROP MATERIALIZED VIEW IF EXISTS pta_exit_attribution; DROP MATERIALIZED VIEW IF EXISTS pta_slippage_by_hour; DROP MATERIALIZED VIEW IF EXISTS pta_strategy_performance; DROP VIEW IF EXISTS pta_trade_summary;\" 2>/dev/null; drizzle-kit push",
    "pta:views": "docker compose exec -T postgres psql -U janus -d janus_production < db/migrations/0027_pta_derived_layer.sql",
    "bot:start": "pm2 start ecosystem.config.cjs --env production",
    "bot:stop": "pm2 stop janus-bot",
    "bot:restart": "pm2 restart janus-bot",
    "bot:logs": "pm2 logs janus-bot",
    "bot:stop-all": "pm2 stop all",
    "bot:kill": "pm2 kill"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.965.0",
    "@aws-sdk/s3-request-presigner": "^3.965.0",
    "@hono/node-server": "^1.14.3",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
