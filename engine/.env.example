# ─── Exchange Selection ────────────────────────────────────────────────────────
# Comma-separated: "delta", "coindcx", or both
ACTIVE_EXCHANGES=coindcx

# ─── CoinDCX (execution + account data via REST/WS; market data via Binance) ──
COINDCX_API_KEY=
COINDCX_API_SECRET=

# ─── Delta Exchange India (own data source + execution) ───────────────────────
DELTA_API_KEY=
DELTA_API_SECRET=
DELTA_BASE_URL=https://cdn-ind.deltaex.org
DELTA_WS_URL=wss://socket.india.delta.exchange

# ─── Risk config ──────────────────────────────────────────────────────────────
RISK_MIN_CONFIDENCE=0.70
RISK_MAX_PCT_PER_TRADE=0.005
RISK_MAX_OPEN_POSITIONS=5
RISK_MAX_LEVERAGE=10
RISK_MAX_DRAWDOWN_PCT=0.15

# ─── Execution gate ───────────────────────────────────────────────────────────
PLACE_ORDERS=false          # Set to "true" to enable live order placement

# ─── Account ──────────────────────────────────────────────────────────────────
ENGINE_ACCOUNT_ID=default

# ─── Symbols ──────────────────────────────────────────────────────────────────
SYMBOLS_COINDCX=BTCUSDT,ETHUSDT,SOLUSDT
SYMBOLS_DELTA=BTCUSDT,ETHUSDT
CANDLE_INTERVAL=1m

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
